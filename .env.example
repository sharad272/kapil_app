# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where magic-link emails redirect back to.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hugging Face Inference Providers (same keys as the Marvel project)
# Token: https://huggingface.co/settings/tokens — enable Inference Providers
HF_TOKEN=""
HF_BASE_URL="https://router.huggingface.co/v1"
LLM_MODEL="openai/gpt-oss-120b"

# Optional fallback if Hugging Face credits or rate limits trip
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="openai/gpt-oss-120b"
